# ASCII Solar System Cleanup Script
# Turns off ASCII solar system and restores default Digistar state
# 
# USAGE:
# script play $Content\User\Scripts\ascii_solar_system_cleanup.ds

# ============================================
# FADE OUT SOLAR SYSTEM
# ============================================

# Fade out all planet objects
asciiSun intensity 0 dur 2
asciiMercury intensity 0 dur 2
asciiVenus intensity 0 dur 2
asciiEarth intensity 0 dur 2
asciiMars intensity 0 dur 2
asciiJupiter intensity 0 dur 2
asciiSaturn intensity 0 dur 2
asciiUranus intensity 0 dur 2
asciiNeptune intensity 0 dur 2

# Fade out orbit rings
asciiMercuryOrbit intensity 0 dur 2
asciiVenusOrbit intensity 0 dur 2
asciiEarthOrbit intensity 0 dur 2
asciiMarsOrbit intensity 0 dur 2
asciiJupiterOrbit intensity 0 dur 2
asciiSaturnOrbit intensity 0 dur 2
asciiUranusOrbit intensity 0 dur 2
asciiNeptuneOrbit intensity 0 dur 2

# Wait for fade to complete
wait 3

# ============================================
# DELETE ALL OBJECTS
# ============================================

# Delete scene (removes all child objects)
delete asciiSolarSystem
delete asciiCamera

# ============================================
# RESTORE DEFAULT STATE
# ============================================

# Reset to default view
system reset

# Turn on standard sky elements
stars on
stars magnitude 6.5
constellations on
constellations style stick
horizon on
cardinal on

# Set default camera
dome position cartesian 0 0 0
dome attitude cartesian 0 0 0

# Turn off cove lights to neutral
coveLights segment all 0 0 0 duration 2

# Message
system message "ASCII Solar System cleanup complete - Default state restored"
