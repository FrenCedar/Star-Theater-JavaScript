{
  "Ds.SendMessage Info": {
    "prefix": "dsmsg",
    "body": [
      "Ds.SendMessage(0, \"${1:message}\");"
    ],
    "description": "Send info message (level 0)"
  },
  "Ds.SendMessage Warning": {
    "prefix": "dswarn",
    "body": [
      "Ds.SendMessage(1, \"${1:warning message}\");"
    ],
    "description": "Send warning message (level 1)"
  },
  "Ds.SendMessage Error": {
    "prefix": "dserr",
    "body": [
      "Ds.SendMessage(2, \"${1:error message}\");"
    ],
    "description": "Send error message (level 2)"
  },
  "Ds.Sleep": {
    "prefix": "dssleep",
    "body": [
      "Ds.Sleep(${1:1.0});"
    ],
    "description": "Pause execution (in seconds)"
  },
  "Ds.Wait": {
    "prefix": "dswait",
    "body": [
      "Ds.Wait(${1:5.0});"
    ],
    "description": "Wait without blocking Digistar (in seconds)"
  },
  "Ds.GetObjectAttr": {
    "prefix": "dsgetattr",
    "body": [
      "const ${2:value} = Ds.GetObjectAttr(\"${1:objectName}\", \"${3:attribute}\");"
    ],
    "description": "Get object attribute value"
  },
  "Ds.SetObjectAttr": {
    "prefix": "dssetattr",
    "body": [
      "Ds.SetObjectAttr(\"${1:objectName}\", \"${2:attribute}\", ${3:value});"
    ],
    "description": "Set object attribute (instant)"
  },
  "Ds.SetObjectAttr with Controller": {
    "prefix": "dssetctrl",
    "body": [
      "Ds.SetObjectAttr(\"${1:objectName}\", \"${2:attribute}\", ${3:value}, {",
      "    time: ${4:5.0},",
      "    func: \"${5|Linear,EaseIn,EaseOut,EaseInOut|}\"",
      "});"
    ],
    "description": "Set object attribute with animation controller"
  },
  "Ds.CreateObject": {
    "prefix": "dscreate",
    "body": [
      "Ds.CreateObject(\"${1:objectName}\", \"${2:class}\", \"${3|permanent,transient,temporary|}\");"
    ],
    "description": "Create a new Digistar object"
  },
  "Ds.DeleteObject": {
    "prefix": "dsdelete",
    "body": [
      "Ds.DeleteObject(\"${1:objectName}\");"
    ],
    "description": "Delete a Digistar object"
  },
  "Ds.SceneAddObject": {
    "prefix": "dsadd",
    "body": [
      "Ds.SceneAddObject(\"${1:objectName}\");"
    ],
    "description": "Add object to scene (make visible)"
  },
  "Ds.SceneRemoveObject": {
    "prefix": "dsremove",
    "body": [
      "Ds.SceneRemoveObject(\"${1:objectName}\");"
    ],
    "description": "Remove object from scene (hide)"
  },
  "Create and Configure Object": {
    "prefix": "dsobject",
    "body": [
      "// Create ${1:objectName}",
      "Ds.CreateObject(\"${1:objectName}\", \"${2:class}\", \"temporary\");",
      "Ds.SetObjectAttr(\"${1:objectName}\", \"position\", {x: ${3:0}, y: ${4:0}, z: ${5:0}});",
      "Ds.SetObjectAttr(\"${1:objectName}\", \"color\", {r: ${6:255}, g: ${7:255}, b: ${8:255}});",
      "Ds.SetObjectAttr(\"${1:objectName}\", \"visible\", true);",
      "Ds.SceneAddObject(\"${1:objectName}\");"
    ],
    "description": "Create and configure a new object"
  },
  "Fade In Animation": {
    "prefix": "dsfadein",
    "body": [
      "Ds.SetObjectAttr(\"${1:objectName}\", \"intensity\", 0);",
      "Ds.SetObjectAttr(\"${1:objectName}\", \"intensity\", ${2:100}, {time: ${3:2.0}, func: \"EaseIn\"});"
    ],
    "description": "Fade in object from 0 to full intensity"
  },
  "Fade Out Animation": {
    "prefix": "dsfadeout",
    "body": [
      "Ds.SetObjectAttr(\"${1:objectName}\", \"intensity\", 0, {time: ${2:2.0}, func: \"EaseOut\"});"
    ],
    "description": "Fade out object to 0 intensity"
  },
  "Pulse Animation Loop": {
    "prefix": "dspulse",
    "body": [
      "function pulse${1:Object}() {",
      "    while (true) {",
      "        Ds.SetObjectAttr(\"${2:objectName}\", \"intensity\", ${3:100}, {time: ${4:1.0}, func: \"EaseInOut\"});",
      "        Ds.Wait(${4:1.0});",
      "        Ds.SetObjectAttr(\"${2:objectName}\", \"intensity\", ${5:20}, {time: ${4:1.0}, func: \"EaseInOut\"});",
      "        Ds.Wait(${4:1.0});",
      "    }",
      "}"
    ],
    "description": "Create pulsing animation loop"
  },
  "Ds.FileRead": {
    "prefix": "dsread",
    "body": [
      "const ${2:data} = Ds.FileRead(Ds.ResolvePath(\"${1:$Content/file.txt}\"));"
    ],
    "description": "Read file contents"
  },
  "Ds.FileWrite": {
    "prefix": "dswrite",
    "body": [
      "const lines = [",
      "    \"${2:line 1}\",",
      "    \"${3:line 2}\"",
      "];",
      "Ds.FileWrite(Ds.ResolvePath(\"${1:$Content/output.txt}\"), lines);"
    ],
    "description": "Write array of lines to file"
  },
  "Ds.ResolvePath": {
    "prefix": "dsresolve",
    "body": [
      "Ds.ResolvePath(\"${1:$Content/}${2:filename}\")"
    ],
    "description": "Resolve Digistar path variable"
  },
  "Ds.SystemCommand": {
    "prefix": "dssyscmd",
    "body": [
      "Ds.SystemCommand(\"${1:command}\");"
    ],
    "description": "Execute system command"
  },
  "Position Cartesian": {
    "prefix": "dsposcart",
    "body": [
      "{",
      "    x: ${1:0},",
      "    y: ${2:0},",
      "    z: ${3:0},",
      "    mode: \"Cartesian\",",
      "    units: \"${4|meter,kilometer,AU,parsec,light_year|}\"",
      "}"
    ],
    "description": "Cartesian position object"
  },
  "Position Spherical": {
    "prefix": "dspossph",
    "body": [
      "{",
      "    x: ${1:0},      // azimuth (radians)",
      "    y: ${2:0},      // elevation (radians)",
      "    z: ${3:1.0},    // radius",
      "    mode: \"Spherical\",",
      "    units: \"${4|meter,kilometer,AU,parsec,light_year|}\"",
      "}"
    ],
    "description": "Spherical position object (Az/El/Radius)"
  },
  "Position Celestial": {
    "prefix": "dsposcel",
    "body": [
      "{",
      "    x: ${1:0},      // Right Ascension (radians)",
      "    y: ${2:0},      // Declination (radians)",
      "    z: ${3:1.0},    // Distance",
      "    mode: \"Celestial\",",
      "    units: \"${4|meter,kilometer,AU,parsec,light_year|}\"",
      "}"
    ],
    "description": "Celestial position object (RA/Dec/Distance)"
  },
  "Color RGB": {
    "prefix": "dscolor",
    "body": [
      "{r: ${1:255}, g: ${2:255}, b: ${3:255}}"
    ],
    "description": "RGB color object"
  },
  "Degrees to Radians": {
    "prefix": "dsrad",
    "body": [
      "(${1:degrees} * Math.PI / 180.0)"
    ],
    "description": "Convert degrees to radians"
  },
  "Radians to Degrees": {
    "prefix": "dsdeg",
    "body": [
      "(${1:radians} * 180.0 / Math.PI)"
    ],
    "description": "Convert radians to degrees"
  },
  "Try-Catch Error Handler": {
    "prefix": "dstry",
    "body": [
      "try {",
      "    ${1:// Your code here}",
      "} catch (error) {",
      "    Ds.SendMessage(2, `Error: \\${error}`);",
      "    Ds.SendMessage(2, `Stack: \\${error.stack}`);",
      "}"
    ],
    "description": "Try-catch with Digistar error logging"
  },
  "Digistar Script Template": {
    "prefix": "dstemplate",
    "body": [
      "/**",
      " * ${1:Script Name}",
      " * ${2:Description}",
      " * ",
      " * Author: ${3:Your Name}",
      " * Date: ${CURRENT_YEAR}-${CURRENT_MONTH}-${CURRENT_DATE}",
      " */",
      "",
      "// Configuration",
      "const CONFIG = {",
      "    ${4:option}: ${5:value}",
      "};",
      "",
      "// Main function",
      "function main() {",
      "    try {",
      "        Ds.SendMessage(0, \"Starting ${1:Script Name}...\");",
      "        ",
      "        ${6:// Your code here}",
      "        ",
      "        Ds.SendMessage(0, \"${1:Script Name} completed successfully\");",
      "    } catch (error) {",
      "        Ds.SendMessage(2, `Error in ${1:Script Name}: \\${error}`);",
      "        Ds.SendMessage(2, `Stack: \\${error.stack}`);",
      "    }",
      "}",
      "",
      "// Execute",
      "main();"
    ],
    "description": "Complete Digistar script template"
  },
  "Cove Lights Set Segment": {
    "prefix": "dscove",
    "body": [
      "Ds.SendStringCommand(`coveLights segment ${1:0} ${2:255} ${3:255} ${4:255} duration ${5:1.0}`);"
    ],
    "description": "Set cove light segment color with fade effect"
  },
  "Cove Lights All Segments": {
    "prefix": "dscoveall",
    "body": [
      "for (let seg = 0; seg < ${1:128}; seg++) {",
      "    Ds.SendStringCommand(`coveLights segment \\${seg} ${2:255} ${3:255} ${4:255} duration ${5:2.0}`);",
      "}"
    ],
    "description": "Set all cove light segments"
  },
  "Cove Lights Fade Effect": {
    "prefix": "dscovefade",
    "body": [
      "function ${1:fadeEffect}(startColor, endColor, duration) {",
      "    for (let seg = 0; seg < 128; seg++) {",
      "        Ds.SendStringCommand(",
      "            `coveLights segment \\${seg} \" +",
      "            `\\${endColor.r} \\${endColor.g} \\${endColor.b} \" +",
      "            `duration \\${duration}`",
      "        );",
      "    }",
      "}"
    ],
    "description": "Cove lights fade effect function"
  },
  "Get Object Position in Dome": {
    "prefix": "dsdomepos",
    "body": [
      "const ${2:pos} = Ds.GetObjPositionInDome(\"${1:objectName}\");",
      "if (${2:pos}) {",
      "    const azimuth = ${2:pos}.azimuth;",
      "    const elevation = ${2:pos}.elevation;",
      "    ${3:// Use position}",
      "}"
    ],
    "description": "Get object's dome position (Az/El)"
  },
  "Scene Date/Time": {
    "prefix": "dsdate",
    "body": [
      "const julianDate = ${1:2451545.0};  // J2000.0",
      "Ds.SceneSetDate(julianDate);"
    ],
    "description": "Set scene Julian date"
  },
  "Attribute Callback": {
    "prefix": "dscallback",
    "body": [
      "Ds.SetObjectAttrCallback(\"${1:objectName}\", \"${2:attribute}\", function(value) {",
      "    Ds.SendMessage(0, `${2:attribute} changed to: \\${value}`);",
      "    ${3:// React to attribute change}",
      "});"
    ],
    "description": "Set attribute change callback"
  },
  "Check Object Exists": {
    "prefix": "dsexists",
    "body": [
      "if (Ds.GetObjectID(\"${1:objectName}\") !== 0) {",
      "    ${2:// Object exists}",
      "} else {",
      "    Ds.SendMessage(1, \"Object '${1:objectName}' not found\");",
      "}"
    ],
    "description": "Check if object exists"
  },
  "Animation Loop": {
    "prefix": "dsloop",
    "body": [
      "let ${1:running} = true;",
      "let ${2:frame} = 0;",
      "",
      "while (${1:running}) {",
      "    ${3:// Animation code}",
      "    ",
      "    Ds.Sleep(${4:0.033});  // ~30 FPS",
      "    ${2:frame}++;",
      "    ",
      "    // Safety limit",
      "    if (${2:frame} > ${5:1000}) {",
      "        ${1:running} = false;",
      "    }",
      "}"
    ],
    "description": "Animation loop with frame counter"
  },
  "Ds.Web.SendStringCommand": {
    "prefix": "dswebcmd",
    "body": [
      "Ds.Web.SendStringCommand(\"${1:command}\", function(result) {",
      "    if (result.error) {",
      "        console.log(\"Error: \" + result.message);",
      "    } else {",
      "        ${2:// Success}",
      "    }",
      "});"
    ],
    "description": "Send command via Web API with callback"
  },
  "Ds.Web.SendStringCommand (simple)": {
    "prefix": "dswebcmds",
    "body": [
      "Ds.Web.SendStringCommand(\"${1:command}\");"
    ],
    "description": "Send command via Web API (no callback)"
  },
  "Ds.Web.CreateObject": {
    "prefix": "dswebcreate",
    "body": [
      "Ds.Web.CreateObject(\"${1:objectName}\", \"${2:className}\", \"${3|temp,perm,pers|}\", function(result) {",
      "    if (!result.error) {",
      "        ${4:// Object created}",
      "    }",
      "});"
    ],
    "description": "Create object via Web API"
  },
  "Ds.Web.SceneAddObject": {
    "prefix": "dswebscene",
    "body": [
      "Ds.Web.SceneAddObject(\"${1:scene}\", \"${2:object}\", \"${3|normal,distant,fixed,landscape,near|}\", function(result) {",
      "    if (!result.error) {",
      "        ${4:// Object added to scene}",
      "    }",
      "});"
    ],
    "description": "Add object to scene via Web API"
  },
  "Ds.Web.DirectoryOpen": {
    "prefix": "dswebdir",
    "body": [
      "var dirRef = Ds.Web.DirectoryOpen(\"${1:\\$Content\\\\path}\", \"${2:*.ds}\");",
      "while (true) {",
      "    var dirItem = Ds.Web.DirectoryGetItem(dirRef);",
      "    if (dirItem.item === \"\") break;",
      "    ",
      "    if (dirItem.isDirectory) {",
      "        console.log(\"Directory: \" + dirItem.item);",
      "    } else {",
      "        console.log(\"File: \" + dirItem.item);",
      "    }",
      "}",
      "Ds.Web.DirectoryClose(dirRef);"
    ],
    "description": "Browse directory via Web API"
  },
  "Ds.Web.GetObjectAttrAsStringCommand": {
    "prefix": "dswebget",
    "body": [
      "var ${2:cmd} = Ds.Web.GetObjectAttrAsStringCommand(\"${1:object}\", \"${3:attribute}\");"
    ],
    "description": "Get attribute as command string (Web API)"
  },
  "Ds.Web.SetObjectAttrPart": {
    "prefix": "dswebset",
    "body": [
      "Ds.Web.SetObjectAttrPart(\"${1:object}\", \"${2:attribute}\", \"${3|x,y,z,r,g,b,value|}\", ${4:value}, ${5:2.0});"
    ],
    "description": "Set attribute part with duration (Web API)"
  },
  "Web Control Panel HTML Template": {
    "prefix": "dswebhtml",
    "body": [
      "<!DOCTYPE html>",
      "<html>",
      "<head>",
      "    <title>${1:Digistar Control}</title>",
      "    <script src=\"/digistar/DigistarWeb.js\"></script>",
      "    <style>",
      "        body { background: #1e1e2e; color: #e0e0e0; font-family: Arial; }",
      "        button { padding: 15px; margin: 10px; font-size: 16px; cursor: pointer; }",
      "    </style>",
      "</head>",
      "<body>",
      "    <h1>${1:Digistar Control}</h1>",
      "    <button onclick=\"${2:sendCommand}()\">Execute</button>",
      "    ",
      "    <script>",
      "        function ${2:sendCommand}() {",
      "            Ds.Web.SendStringCommand(\"${3:command}\", function(result) {",
      "                if (result.error) {",
      "                    alert(\"Error: \" + result.message);",
      "                } else {",
      "                    alert(\"Success\");",
      "                }",
      "            });",
      "        }",
      "    </script>",
      "</body>",
      "</html>"
    ],
    "description": "HTML template for web control interface"
  },
  "Web Control Button Function": {
    "prefix": "dswebbtn",
    "body": [
      "function ${1:buttonName}() {",
      "    Ds.Web.SendStringCommand(\"${2:command}\", function(result) {",
      "        if (result.error) {",
      "            log(\"Error: \" + result.message, true);",
      "        } else {",
      "            log(\"${3:Success message}\");",
      "        }",
      "    });",
      "}"
    ],
    "description": "Web control button function with logging"
  },
  "Ds.Web.CreateToggleButton": {
    "prefix": "dswebtoggle",
    "body": [
      "Ds.Web.CreateToggleButton(",
      "    \"${1:btnId}\", \"${2:parentId}\", \"${3:objectName}\", \"${4:Button Text}\",",
      "    ${5:10}, ${6:10}, ${7:100}, ${8:40},",
      "    \"#888\", \"#fff\", \"14px\",",
      "    \"#333\", \"#0066cc\",",
      "    \"\", \"\",",
      "    \"#555\", \"#0099ff\",",
      "    2, 8,",
      "    \"${9:Tooltip text}\"",
      ");"
    ],
    "description": "Create toggle button (Web API)"
  },
  "Ds.Web.StartUpdatesFromHost": {
    "prefix": "dswebstart",
    "body": [
      "// Start syncing with Digistar Host",
      "Ds.Web.StartUpdatesFromHost();"
    ],
    "description": "Start updates from Digistar Host"
  }
}
