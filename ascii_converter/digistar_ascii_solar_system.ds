# Digistar ASCII Solar System Display Script
# Displays planets with ASCII art textures for pre-show/setup visuals
# 
# REQUIREMENTS:
# - ASCII texture files in $Content\User\Textures\ASCII_Planets\
# - Generate these using image_to_ascii.py converter
#
# USAGE:
# script play $Content\User\Scripts\ascii_converter\digistar_ascii_solar_system.ds

# Clean slate
system reset

# Turn off default starfield for clean background
stars off

# Create scene for ASCII planets
asciiScene is sceneClass type temporary
scene add asciiScene

# Create camera for the scene
asciiCam is cameraClass type temporary
asciiScene add asciiCam
dome add asciiCam

# Position camera
asciiCam position cartesian 0 0 0
asciiCam attitude cartesian 0 1 0

# ======================================
# ASCII PLANET CONFIGURATION
# ======================================

# Path to ASCII textures
# NOTE: Update these paths to match your texture locations

# Sun - Center, large
asciiSun is solidModelClass type temporary
asciiSun model $Software\Models\Primitives\sphere.x
asciiSun modelTexture $Content\User\Textures\ASCII_Planets\ascii_sun.png
asciiSun color 100 80 20
asciiSun scale 8 8 8
asciiSun position cartesian 0 0 200
asciiScene add asciiSun fixed
asciiSun intensity 0

# Earth
asciiEarth is solidModelClass type temporary
asciiEarth model $Software\Models\Primitives\sphere.x
asciiEarth modelTexture $Content\User\Textures\ASCII_Planets\ascii_earth.png
asciiEarth color 90 100 100
asciiEarth scale 3 3 3
asciiEarth position cartesian 30 -5 180
asciiScene add asciiEarth fixed
asciiEarth intensity 0

# Mars
asciiMars is solidModelClass type temporary
asciiMars model $Software\Models\Primitives\sphere.x
asciiMars modelTexture $Content\User\Textures\ASCII_Planets\ascii_mars.png
asciiMars color 100 60 50
asciiMars scale 2.5 2.5 2.5
asciiMars position cartesian 50 -8 170
asciiScene add asciiMars fixed
asciiMars intensity 0

# Jupiter
asciiJupiter is solidModelClass type temporary
asciiJupiter model $Software\Models\Primitives\sphere.x
asciiJupiter modelTexture $Content\User\Textures\ASCII_Planets\ascii_jupiter.png
asciiJupiter color 100 90 70
asciiJupiter scale 6 6 6
asciiJupiter position cartesian -40 0 190
asciiScene add asciiJupiter fixed
asciiJupiter intensity 0

# Saturn
asciiSaturn is solidModelClass type temporary
asciiSaturn model $Software\Models\Primitives\sphere.x
asciiSaturn modelTexture $Content\User\Textures\ASCII_Planets\ascii_saturn.png
asciiSaturn color 100 95 80
asciiSaturn scale 5 5 5
asciiSaturn position cartesian -70 5 180
asciiScene add asciiSaturn fixed
asciiSaturn intensity 0

# Venus
asciiVenus is solidModelClass type temporary
asciiVenus model $Software\Models\Primitives\sphere.x
asciiVenus modelTexture $Content\User\Textures\ASCII_Planets\ascii_venus.png
asciiVenus color 100 100 90
asciiVenus scale 2.8 2.8 2.8
asciiVenus position cartesian 15 -10 170
asciiScene add asciiVenus fixed
asciiVenus intensity 0

# Mercury
asciiMercury is solidModelClass type temporary
asciiMercury model $Software\Models\Primitives\sphere.x
asciiMercury modelTexture $Content\User\Textures\ASCII_Planets\ascii_mercury.png
asciiMercury color 80 80 80
asciiMercury scale 1.8 1.8 1.8
asciiMercury position cartesian 8 -15 160
asciiScene add asciiMercury fixed
asciiMercury intensity 0

# ======================================
# ANIMATION SEQUENCE
# ======================================

# Fade in title
titleText intensity 100 dur 2
subtitleText intensity 100 dur 2

wait 1

# Fade in Sun
asciiSun intensity 100 dur 3
sunLabel intensity 100 dur 3

# Start Sun rotation
asciiSun attitude rate 0 5 0

wait 2

# Fade in inner planets
asciiMercury intensity 100 dur 2
asciiVenus intensity 100 dur 2
asciiEarth intensity 100 dur 2
earthLabel intensity 100 dur 2
asciiMars intensity 100 dur 2
marsLabel intensity 100 dur 2

# Start rotations
asciiMercury attitude rate 0 10 0
asciiVenus attitude rate 0 -8 0
asciiEarth attitude rate 0 15 0
asciiMars attitude rate 0 12 0

wait 2

# Fade in outer planets
asciiJupiter intensity 100 dur 3
jupiterLabel intensity 100 dur 3
asciiSaturn intensity 100 dur 3
saturnLabel intensity 100 dur 3

# Start rotations
asciiJupiter attitude rate 0 20 0
asciiSaturn attitude rate 0 18 0

wait 5

# Dim title
titleText intensity 30 dur 2
subtitleText intensity 30 dur 2

# Hold display
# (Script will stay here - use Fade/Stop/Reset to clean up)
wait 3600

# Cleanup (when script is stopped)
titleText intensity 0 dur 2
subtitleText intensity 0 dur 2
asciiSun intensity 0 dur 3
asciiEarth intensity 0 dur 3
asciiMars intensity 0 dur 3
asciiJupiter intensity 0 dur 3
asciiSaturn intensity 0 dur 3
asciiMercury intensity 0 dur 3
asciiVenus intensity 0 dur 3
sunLabel intensity 0 dur 3
earthLabel intensity 0 dur 3
marsLabel intensity 0 dur 3
jupiterLabel intensity 0 dur 3
saturnLabel intensity 0 dur 3

wait 4

# Objects will auto-delete on system reset (type temporary)
